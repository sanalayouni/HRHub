# Copy to .env and fill in real values. Never commit .env itself.

# Supabase Postgres connection string (pooler endpoint).
# URL-encode any special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Login for the HR dashboard.
HR_EMAIL=hr@example.com
# bcrypt hash of the HR password - generate, don't invent:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
HR_PASSWORD_HASH=

# Secret used to sign JWTs. Generate a fresh random one per environment:
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
