# Environment variables
.env
.env.*
# ...but a value-free template is useful to share
!.env.example

# Credentials / secrets
credentials.json
service-account.json
*.pem
*.key
*.secret

# Local databases / data
*.db
*.sqlite
*.sqlite3

# n8n local data
.n8n/

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Sensitive company data
employee_data/
real_emails/
private_policies/

# Node / frontend build output.
# The Vite and Flutter scaffolds already ignore these in their own subfolders;
# these are here so a future package.json at the repo root is covered too.
node_modules/
dist/
build/
.vite/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / tooling
.idea/

# Local-only working folders - not part of the shipped project
.claude/
design.ref/